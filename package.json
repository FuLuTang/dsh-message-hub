{
  "name": "dsh-message-hub",
  "version": "0.1.0",
  "description": "A channel registry and transport-neutral communication hub plugin for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuLuTang/dsh-message-hub.git"
  },
  "homepage": "https://github.com/FuLuTang/dsh-message-hub#readme",
  "bugs": {
    "url": "https://github.com/FuLuTang/dsh-message-hub/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "message-hub",
    "communication"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "catalog": {
      "category": "integration",
      "summary": {
        "en": "Manage user-defined inbound and outbound communication channels for DSH.",
        "zh": "管理用户自定义的 DSH 消息接入与发出渠道。"
      }
    }
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check lib/client.js",
    "build": "node scripts/build-client.mjs",
    "verify:package": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
